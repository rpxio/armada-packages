From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: odin3: enable DPU dithering, add charging LED

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-odin3.dts
@@ -217,6 +217,9 @@
 &display_panel {
 	compatible = "chipone,icna3520";
 
+	/* 8bpc DSI link; dither the DPU 10-bit downconvert to hide banding */
+	armada,dpu-8bpc-dither;
+
 	reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;
 
 	vddio-supply = <&vreg_l12b_1p8>;
@@ -230,6 +233,41 @@
 	pinctrl-names = "default", "sleep";
 
 	rotation = <90>;
+};
+
+/*
+ * Charging LED: the PM8550 tri-colour LED on LPG channels 1-3 (channel 4 is
+ * the fan PWM). Same node shape as the AYN Android DT
+ * (pm8550@1/led-controller, led@1..3 = red/green/blue). Android shows amber
+ * while charging, green at >=90 % or full, red below 20 % (blinking when
+ * discharging), all at 2/255 brightness. The kernel power-supply trigger
+ * covers the charging (orange) and full (green) states; the low-battery red
+ * state and the dim brightness are not reproduced yet.
+ */
+&pm8550_pwm {
+	multi-led {
+		color = <LED_COLOR_ID_RGB>;
+		function = LED_FUNCTION_CHARGING;
+		linux,default-trigger = "battery-charging-orange-full-green";
+
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		led@1 {
+			reg = <1>;
+			color = <LED_COLOR_ID_RED>;
+		};
+
+		led@2 {
+			reg = <2>;
+			color = <LED_COLOR_ID_GREEN>;
+		};
+
+		led@3 {
+			reg = <3>;
+			color = <LED_COLOR_ID_BLUE>;
+		};
+	};
 };
 
 &remoteproc_adsp {
