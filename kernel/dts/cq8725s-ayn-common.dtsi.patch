From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: cq8725s: configure the Odin 3 gamepad

--- a/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/cq8725s-ayn-common.dtsi
@@ -113,7 +113,6 @@
 			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
 			debounce-interval = <15>;
 			linux,can-disable;
-			wakeup-source;
 		};
 	};
 
@@ -1048,7 +1048,7 @@
 		reg = <0xf000>, <0xf100>, <0xf200>;
 		interrupts = <0x07 0xf0 0x1 IRQ_TYPE_EDGE_RISING>;
 		interrupt-names = "fifo-empty";
-		qcom,vmax-mv = <1700>; // 0x6a4
+		qcom,vmax-mv = <1400>; // AYN Android "Highest" (user_vmax_mv 1410 -> VMAX reg 0x1c); 1700 drifts with heat
 		qcom,brake-mode = <BRAKE_CLOSE_LOOP>;
 		qcom,lra-period-us = <5880>;
 		qcom,brake-pattern = /bits/ 8 <0xff 0x3f 0x1f>;
@@ -1390,6 +1390,9 @@
 
 	gamepad {
 		compatible = "gamepad,rsinput";
+		rumble-haptics;
+		axis-range = <1024>;
+		axis-deadzone = <70>;
 
 		gamepad-name = "AYN Odin3 Gamepad";
 		gamepad-bus = <0x0003>;
