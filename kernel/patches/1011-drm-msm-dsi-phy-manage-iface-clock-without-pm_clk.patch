From: Armada <noreply@armada.local>
Subject: [PATCH] drm/msm/dsi: phy: manage the iface clock directly instead of via pm_clk

The DSI PHY hands its "iface" AHB clock to pm_clk, which prepares the
clock once at probe and only enables and disables it around runtime PM.
On RPMh platforms the XO (bi_tcxo) vote is made in the prepare path,
because talking to RPMh can sleep, and disp_cc_mdss_ahb_clk sits under
the XO through the MDSS AHB RCG. A permanently prepared leaf therefore
keeps the crystal oscillator voted on in every RPMh set, including the
sleep set, for as long as the PHY driver is bound.

On the AYN Odin 3 (SM8750) this is the last display reference holding
the XO through suspend-to-idle once the DSI host, DPU and MDSS have all
released their AHB references, and it forbids AOSS deep sleep. Get the
clock with devm_clk_get() and prepare/enable it in the runtime resume
callback and disable/unprepare it in runtime suspend, the way the DSI
host manages its bus clocks.

--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
@@ -107,6 +107,7 @@
 	int id;
 
 	struct regulator_bulk_data *supplies;
+	struct clk *ahb_clk;
 
 	struct msm_dsi_dphy_timing timing;
 	const struct msm_dsi_phy_cfg *cfg;
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
@@ -5,7 +5,7 @@
 
 #include <linux/clk-provider.h>
 #include <linux/platform_device.h>
-#include <linux/pm_clock.h>
+#include <linux/clk.h>
 #include <linux/pm_runtime.h>
 #include <dt-bindings/phy/phy.h>
 
@@ -687,13 +687,10 @@
 	if (ret)
 		return ret;
 
-	ret = devm_pm_clk_create(dev);
-	if (ret)
-		return ret;
-
-	ret = pm_clk_add(dev, "iface");
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "Unable to get iface clk\n");
+	phy->ahb_clk = devm_clk_get(dev, "iface");
+	if (IS_ERR(phy->ahb_clk))
+		return dev_err_probe(dev, PTR_ERR(phy->ahb_clk),
+				     "Unable to get iface clk\n");
 
 	if (phy->cfg->ops.pll_init) {
 		ret = phy->cfg->ops.pll_init(phy);
@@ -707,12 +704,35 @@
 	if (ret)
 		return dev_err_probe(dev, ret,
 				     "Failed to register clk provider\n");
+
+	return 0;
+}
+
+/*
+ * Manage the AHB clock by hand rather than through pm_clk: pm_clk keeps the
+ * clock prepared for the lifetime of the device and only toggles enable,
+ * and on RPMh platforms the XO vote is taken at prepare time, so a
+ * pm_clk-managed leaf keeps the crystal oscillator requested through
+ * system suspend.
+ */
+static int dsi_phy_runtime_suspend(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
 
+	clk_disable_unprepare(phy->ahb_clk);
+
 	return 0;
 }
 
+static int dsi_phy_runtime_resume(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	return clk_prepare_enable(phy->ahb_clk);
+}
+
 static const struct dev_pm_ops dsi_phy_pm_ops = {
-	SET_RUNTIME_PM_OPS(pm_clk_suspend, pm_clk_resume, NULL)
+	SET_RUNTIME_PM_OPS(dsi_phy_runtime_suspend, dsi_phy_runtime_resume, NULL)
 };
 
 static struct platform_driver dsi_phy_platform_driver = {
