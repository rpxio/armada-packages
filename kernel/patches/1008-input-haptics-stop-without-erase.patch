From: Randall <randall@rpx.io>
Subject: [PATCH] Input: qcom-hv-haptics: make playback(0) a stop, not an erase

The bridge shim qcom_spmi_haptics_global_playback() turned every stop
request into ff->erase() because the driver's own playback callback
ignored val == 0. That drops the loaded effect, so a client that uploads
once and then plays and stops repeatedly gets exactly one burst; every
later play hits "Trying to playback while no effect is loaded" and is
silently ignored. SDL hides this by re-uploading before each rumble call;
fftest, upload-once emulators and anything using the evdev contract as
documented do not.

Give the driver a real stop: playback(0) cancels the pending stop timer,
disables play (with the configured brake) and drops the rail, but keeps
chip_effect_loaded so the effect can be played again. playback(1) re-enables
the rail before playing. The shim now forwards val to playback() for both
directions; EVIOCRMFF still reaches haptics_erase().

While tracing this, the stop timer for constant effects was found to be
armed at upload time from replay.length, so an effect uploaded and played
later was cut short (a 1000 ms effect stopped 1.0 s after upload, before
playback had started). Remember the length at upload and arm the timer
when playback actually starts.

Reproducer (AYN Odin 3, Armada 7.2.3): upload one FF_RUMBLE effect, then
play/stop it three times with 1 s gaps. Before: one burst. Expected after:
three.
---
diff --git a/drivers/input/misc/qcom-hv-haptics.c b/drivers/input/misc/qcom-hv-haptics.c
index da5fb2f..f7417a4 100644
--- a/drivers/input/misc/qcom-hv-haptics.c
+++ b/drivers/input/misc/qcom-hv-haptics.c
@@ -794,6 +794,7 @@ struct haptics_chip {
 	struct work_struct		set_gain_work;
 	volatile bool			chip_effect_loaded;
 	volatile bool			chip_is_playing;
+	u32				constant_length_ms;
 	struct list_head		mmap_effect_list;
 	int				fifo_empty_irq;
 	u32				hpwr_voltage_mv;
@@ -3120,18 +3121,26 @@ static int haptics_stop_fifo_play(struct haptics_chip *chip)
 	return 0;
 }
 
-static void haptics_stop_constant_effect_play(struct work_struct *work)
+static int haptics_stop_play(struct haptics_chip *chip)
 {
-	struct haptics_chip *chip = container_of(work, struct haptics_chip, stop_work.work);
-	int rc = 0;
+	int rc;
 
 	rc = haptics_enable_play(chip, false);
 	if (rc < 0)
-		dev_err(chip->dev, "stop constant effect play failed\n");
+		dev_err(chip->dev, "stop play failed, rc=%d\n", rc);
 
 	rc = haptics_enable_hpwr_vreg(chip, false);
 	if (rc < 0)
-		dev_err(chip->dev, "disable hpwr_vreg failed\n");
+		dev_err(chip->dev, "disable hpwr_vreg failed, rc=%d\n", rc);
+
+	return rc;
+}
+
+static void haptics_stop_constant_effect_play(struct work_struct *work)
+{
+	struct haptics_chip *chip = container_of(work, struct haptics_chip, stop_work.work);
+
+	haptics_stop_play(chip);
 }
 
 static inline bool is_haptics_runtime_pm_enabled(struct haptics_chip *chip)
@@ -3280,7 +3289,8 @@ static int haptics_upload_effect(struct input_dev *dev,
 		amplitude = tmp / 0x7fff;
 		dev_dbg(chip->dev, "upload constant effect, length = %dms, amplitude = %#x\n",
 				length_ms, amplitude);
-		schedule_delayed_work(&chip->stop_work, msecs_to_jiffies(length_ms));
+		/* the stop timer is armed when playback starts, not here */
+		chip->constant_length_ms = length_ms;
 		haptics_load_constant_effect(chip, amplitude);
 		if (rc < 0) {
 			dev_err(chip->dev, "set direct play failed, rc=%d\n",
@@ -3369,20 +3379,45 @@ auto_suspend:
 static int haptics_playback(struct input_dev *dev, int effect_id, int val)
 {
 	struct haptics_chip *chip = input_get_drvdata(dev);
+	int rc;
 
 	dev_dbg(chip->dev, "playback val = %d\n", val);
-	if (!!val && !chip->chip_is_playing) {
-		if (!chip->chip_effect_loaded) {
-			dev_dbg(chip->dev, "Trying to playback while no effect is loaded!\n");
+	if (!val) {
+		/*
+		 * Stop, but keep the effect loaded so it can be played again.
+		 * Erasing is EVIOCRMFF's job, not playback(0)'s.
+		 */
+		if (!chip->chip_is_playing)
 			return 0;
-		}
 
-		if (chip->config.measure_lra_impedance && chip->visense_enabled)
-			chip->pattern_start_time = ktime_get_boottime();
+		cancel_delayed_work_sync(&chip->stop_work);
+		return haptics_stop_play(chip);
+	}
+
+	if (chip->chip_is_playing)
+		return 0;
 
-		return haptics_enable_play(chip, true);
+	if (!chip->chip_effect_loaded) {
+		dev_dbg(chip->dev, "Trying to playback while no effect is loaded!\n");
+		return 0;
 	}
 
+	/* a previous stop dropped the rail; a replay needs it back */
+	rc = haptics_enable_hpwr_vreg(chip, true);
+	if (rc < 0)
+		return rc;
+
+	if (chip->config.measure_lra_impedance && chip->visense_enabled)
+		chip->pattern_start_time = ktime_get_boottime();
+
+	rc = haptics_enable_play(chip, true);
+	if (rc < 0)
+		return rc;
+
+	if (chip->constant_length_ms)
+		schedule_delayed_work(&chip->stop_work,
+				msecs_to_jiffies(chip->constant_length_ms));
+
 	return 0;
 }
 
@@ -6768,13 +6803,10 @@ int qcom_spmi_haptics_global_playback(int effect_id, int val) {
 		return -ENODEV;
 	}
 
-	if (val != 0)
-		ret = phapchip->input_dev->ff->playback(phapchip->input_dev, effect_id, val);
-	else
-		ret = phapchip->input_dev->ff->erase(phapchip->input_dev, effect_id);
+	ret = phapchip->input_dev->ff->playback(phapchip->input_dev, effect_id, val);
 
 	if (ret)
-		pr_warn("%s called for %s, error in return (%d)\n", __func__, (val!=0 ? "Playback" : "Erase"), ret);
+		pr_warn("%s called for %s, error in return (%d)\n", __func__, (val!=0 ? "Playback" : "Stop"), ret);
 
 	mutex_unlock(&haptics_global_lock);
 
